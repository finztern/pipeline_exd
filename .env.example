MAIN_ADDRESS=0xВАШ_EXORDE_АДРЕС
VLESS_URL=

# внешний singbox-hub (сеть vpnnet): socks5 для выгрузки (можно списком через запятую: 1080,1082,1083) и http для скачивания моделей
HUB_SOCKS_URL=socks5h://vpn:1080
HUB_HTTP_URL=http://vpn:1081

# direct = напрямую | vpn = только через vless из vpn.txt | proxy = только proxy.txt | auto = самый быстрый
ROUTE_MODE=auto
ROUTE_ALLOW_DIRECT=true
ROUTE_PROXY_MAX_MS=3000
ROUTE_PROBE_POST_BYTES=262144
UPLOAD_CONCURRENCY=6
ROUTE_PROBE_INTERVAL=300
ROUTE_PROBE_SAMPLES=3
ROUTE_PROBE_TIMEOUT=15
ROUTE_PROBE_PARALLEL=32
ROUTE_PROBE_BATCH=60
ROUTE_PROBE_TOP=10
VPN_URLTEST_INTERVAL=10m
ROUTE_SWITCH_MARGIN=0.85
ROUTE_FAIL_COOLDOWN=60

VPN_DISABLE_PQV=false
VPN_LOG_LEVEL=warning

USE_PROXY_BPIPE=false
USE_PROXY_UPIPE=false
USE_PROXY_TRANSLATOR=true

TRANSLATE=true
TRANSLATE_BACKEND=gpu
UPIPE_TRANSLATE=false
TRANSLATE_QUEUE_SIZE=200
TRANSLATE_BATCH_SIZE=8
TRANSLATE_WORKERS=3
TRANSLATE_TIMEOUT_SECONDS=30
TRANSLATE_MAX_CHARS=2000
TRANSLATE_BUSY_FILL=0.9
ARGO_LANG_PACKS=es,pt,fr,de,it,ru,ja
LANG_CONFIDENCE_THRESHOLD=0.90
# langdetect (по умолчанию) | shadow (оба детектора, решает langdetect, расхождения в /stats -> lang_detect) | fasttext
LANG_BACKEND=langdetect
LANG_FT_CONFIDENCE=0.80
LANG_FT_LOW_CONF_MIN=0.40
TRANSLATOR_CPUS=4
TRANSLATOR_OMP_THREADS=2

GPU_TRANSLATOR_URL=http://translator_gpu:8004/
GPU_ROUTE_REASONS=queue_full
GPU_RETRY_SECONDS=2
OPUS_LANGS=es,pt,ja,id,hi,de,fr,ko,tr,ar,it,ru,th,vi,tl,zh,nl,pl,sv,uk,bn,ta,te,mr,ur,he,ro,el,cs,hu,da,fi,no,bg,ca,ml,gu,kn,sr,hr
OPUS_FALLBACK=Helsinki-NLP/opus-mt-mul-en
NLLB_DISABLE=true
GPU_COMPUTE_TYPE=int8
GPU_BATCH_SIZE=2
GPU_MAX_WAIT_SECONDS=0.5
GPU_INFLIGHT=2
GPU_MAX_TOKENS=150
GPU_BEAM_SIZE=1
GPU_QUEUE_SIZE=300
GPU_BUCKET_CAP=400
HF_PROXY=
GPU_TRANSLATOR_HOST_PORT=8004

LANG_FILTER=en
FOREIGN_FORWARD_URL=
MIN_TEXT_LEN=20
MAX_TEXT_LEN=20000
MAX_OLDNESS_SECONDS=86400
MAX_FUTURE_SECONDS=300
QUEUE_LOW_FILL=0.2
QUEUE_HIGH_FILL=0.7

UPIPE_WORKERS=6
UPIPE_QUEUE_LIMIT=200
MAX_DEPTH_CLASSIFICATION=2
MAX_MODEL_TOKENS=400

BPIPE_REPLICAS=1
# лимит CPU-потоков на реплику bpipe (torch/ORT/tokenizers). Откат: 8 (по числу логических ядер)
BPIPE_CPU_THREADS=2
FIXED_BATCH_SIZE=6
TAG_HF_BATCH_SIZE=64
TAG_MAX_LENGTH=512
TAG_SKIP_DEPRECATED=true
CLASSIFICATION_BACKEND=minilm_cosine
BATCH_TIMEOUT_SECONDS=3.0
BPIPE_QUEUE_TRANSLATED_MAX=100
BPIPE_QUEUE_TRANSLATED_HARD_MAX=1000
BPIPE_QUEUE_DEFAULT_MAX=200
BPIPE_QUEUE_BUFFER_MAX=500
BPIPE_BUFFER_DOMAINS=mastodon,truthsocial.com
BPIPE_BUFFER_TTL_SECONDS=7200
UPIPE_TRANSLATED_RETRIES=6
URL_DEDUP_MODE=shadow
URL_DEDUP_BATCH=48
URL_DEDUP_WORKERS=4
URL_LOCAL_DEDUP=true
URL_DEDUP_DOMAINS=
