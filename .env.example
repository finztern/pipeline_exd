# ── Обязательные ──────────────────────────────────────────────
MAIN_ADDRESS=0xВАШ_EXORDE_АДРЕС
VLESS_URL=vless://ВАША_ССЫЛКА

# ── VPN ───────────────────────────────────────────────────────
VPN_DISABLE_PQV=false
VPN_LOG_LEVEL=warning

# ── Прокси по сервисам ────────────────────────────────────────
USE_PROXY_TRANSACTIONEER=true
USE_PROXY_BPIPE=false
USE_PROXY_UPIPE=false
USE_PROXY_TRANSLATOR=true

# ── Перевод (Argo, CPU) ───────────────────────────────────────
TRANSLATE=false
TRANSLATE_QUEUE_SIZE=200
TRANSLATE_BATCH_SIZE=8
TRANSLATE_WORKERS=3
TRANSLATE_TIMEOUT_SECONDS=30
TRANSLATE_MAX_CHARS=2000
TRANSLATE_BUSY_FILL=0.9
ARGO_LANG_PACKS=es,pt,fr,de,it,ru,ja
LANG_CONFIDENCE_THRESHOLD=0.90
TRANSLATOR_CPUS=4
TRANSLATOR_OMP_THREADS=2

# ── Collector ─────────────────────────────────────────────────
LANG_FILTER=en
# пусто = отправка non-en на второй сервер отключена
FOREIGN_FORWARD_URL=http://192.168.0.101:9000/store_item
MIN_TEXT_LEN=20
MAX_TEXT_LEN=20000
MAX_OLDNESS_SECONDS=86400
QUEUE_LOW_FILL=0.2
QUEUE_HIGH_FILL=0.7

# ── Upipe ─────────────────────────────────────────────────────
UPIPE_WORKERS=6
UPIPE_QUEUE_LIMIT=200
MAX_DEPTH_CLASSIFICATION=2
MAX_MODEL_TOKENS=400

# ── Bpipe (GPU) ───────────────────────────────────────────────
BPIPE_REPLICAS=1
FIXED_BATCH_SIZE=6
BATCH_TIMEOUT_SECONDS=3.0
MAX_QUEUE_SIZE=100
